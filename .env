#####################################################
#     WikiGraph - Wikipedia GraphRAG on IRIS        #
#               CONFIG ENV FILE                     #
#   Edit this file according to your requirements   #
#####################################################

# Path to IRIS docker image. Use the InterSystems AI Hub community build
# (load it first from the EAP portal tarball, e.g.:
#   docker image load -i irishealth-community-2026.2.0AI.162.0-docker.tar.gz )
IRIS_IMAGE="containers.intersystems.com/intersystems/iris-community:2026.1"
IRIS_SPORT=51972
IRIS_PORT=52773

# Ollama LLM sidecar
OLLAMA_MODEL="gemma4:e2b"
OLLAMA_URL="http://ollama:11434"
OLLAMA_PORT=11435

# Embedding model - pulled in the Ollama container and reached by IRIS's EMBEDDING datatype
# (%Embedding.OpenAI) via Ollama's OpenAI-compatible /v1/embeddings endpoint. Must be 1024-dim
# to match the schema/HNSW indexes (bge-m3 is multilingual EN/PT; mxbai-embed-large also works).
EMBEDDING_MODEL="leoipulsar/harrier-0.6b:latest"

# WikiGraph application defaults
DEFAULT_LANG="en"
SIMILARITY_THRESHOLD=0.6

# Pyprod ENVs
IRISINSTALLDIR="/usr/irissys"
LD_LIBRARY_PATH=$IRISINSTALLDIR/bin:$IRISINSTALLDIR/dev:${LD_LIBRARY_PATH:-}
IRISUSERNAME="_SYSTEM"
IRISPASSWORD="SYS"
IRISNAMESPACE=GRAPHRAG
COMLIB="/usr/irissys/bin"
PYTHONPATH="/usr/irissys/lib/python"
